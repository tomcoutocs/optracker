# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required for cross-user profiles, trade accept, deck view
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Card sync — RapidAPI (optional; falls back to OPTCG if missing)
RAPIDAPI_KEY=
# NEXT_PUBLIC_RAPIDAPI_KEY=  # alternate name supported by sync

# Protect /api/sync-cards in production (required on Vercel)
CRON_SECRET=generate-with-openssl-rand-hex-32

# Discord bot (Optrackman) — optional
DISCORD_BOT_SECRET=
